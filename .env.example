# ===================== 数据库配置 =====================
# 本地运行用 localhost；Docker 部署时 docker-compose 会自动把 DB_HOST 覆盖为 mysql
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=xinchuang_dw

# ===================== JWT 密钥（登录令牌签名） =====================
# 生产环境务必改成随机字符串，本地演示可用默认值
JWT_SECRET=xinchuang-2026-secret

# ===================== Gitee Token =====================
# 获取方式：https://gitee.com/profile/personal_access_tokens
GITEE_TOKEN=your_gitee_token_here

# ===================== GitHub Token =====================
# 获取方式：https://github.com/settings/tokens （无需任何权限即可提升限额）
# 不填也能运行，但匿名访问限速 60次/小时
GITHUB_TOKEN=your_github_token_here
